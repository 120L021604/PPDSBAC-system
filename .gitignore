# ==============================================
# PPDSBAC 项目专属 .gitignore
# 后端：Python Flask | 前端：Vue3 + Vite
# ==============================================

# --------------------------
# 1. Python 后端相关
# --------------------------
# Python 缓存文件
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境（绝对不要上传）
venv/
env/
ENV/
.venv
env.bak/
venv.bak/

# IDE 配置文件
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# 日志、临时文件
*.log
*.tmp
*.temp
.env
.env.local
.env.*.local

# --------------------------
# 2. Vue3 / Vite 前端相关
# --------------------------
# 依赖文件夹（体积巨大，绝对不要上传）
node_modules/

# 构建产物
dist/
dist-ssr/
*.local

# 环境变量文件
.env
.env.local
.env.*.local

# 测试、覆盖率
coverage/
.nyc_output/

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------
# 3. 系统/IDE 通用文件
# --------------------------
# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# --------------------------
# 4. 项目专属临时文件（可选）
# --------------------------
# 解密后下载的文件、临时加密文件
*.bin
*.enc
decrypted_*
encrypted_*

# 本地配置（不影响项目运行）
local/
temp/